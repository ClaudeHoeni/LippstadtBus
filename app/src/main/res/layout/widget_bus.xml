<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FFFFFF"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Pfeil links"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_arrow_left" />

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:contentDescription="Mikrofon starten"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_mic_center" />

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Pfeil rechts"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_arrow_right" />
</LinearLayout>